{
  "name": "tsukimichi-extensions",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "scripts": {
    "dev": "cross-env BUILD_TYPE=all tsup --watch",
    "build": "cross-env BUILD_TYPE=all tsup --config tsup.config.ts",
    "build:anime": "cross-env BUILD_TYPE=anime tsup --config tsup.config.ts",
    "build:manga": "cross-env BUILD_TYPE=manga tsup --config tsup.config.ts",
    "archive": "cross-env ARCHIVE_TYPE=all node scripts/archiver.js",
    "archive:anime": "cross-env ARCHIVE_TYPE=anime node scripts/archiver.js",
    "archive:manga": "cross-env ARCHIVE_TYPE=manga node scripts/archiver.js",
    "bundle": "pnpm run build && pnpm run archive && pnpm run gen-extension-meta:all",
    "bundle:anime": "pnpm run build:anime && pnpm run archive:anime && pnpm run gen-extension-meta:anime",
    "bundle:manga": "pnpm run build:manga && pnpm run archive:manga && pnpm run gen-extension-meta:manga",
    "gen-extension-meta:anime": "cross-env EXTENSION_TYPE=anime node scripts/generate-extension-meta.js",
    "gen-extension-meta:manga": "cross-env EXTENSION_TYPE=manga node scripts/generate-extension-meta.js",
    "gen-extension-meta:all": "cross-env EXTENSION_TYPE=all node scripts/generate-extension-meta.js",
    "get-changed": "node scripts/get-changed-extensions.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tsukimichi/common": "^1.0.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "axios-retry": "^4.5.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "hls-parser": "^0.16.1",
    "php-serialize": "^5.1.3",
    "protobufjs": "^8.8.0",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.35.1",
    "tough-cookie": "^6.0.0",
    "unpacker": "^1.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.1",
    "@types/unzipper": "^0.10.11",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "glob": "^11.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  }
}
